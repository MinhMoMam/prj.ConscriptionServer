Sheet: "DATA BASE"

columnList:
{% for column in columns -%}
  - {{ column.Name }}
{% endfor %}
{% for column in columns %}
{{column.Name}}:
  ColumnLabel: "{{ column.Title }}"
  Question: "{{ column.Question }}"
  Group: "{{ column.Group }}"
  Object: "{{ column.Object }}"
  DataType: "{{ column.DataType }}"
  PlaceHolder: ""
{% endfor %}